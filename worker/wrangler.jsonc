{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arkkies-auto-login",
  "main": "src/index.ts",
  // Today's date. nodejs_compat is default for this date and is omitted on purpose.
  "compatibility_date": "2026-11-10",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
